# ==============================================================================
# Skill Bridge AI — Environment Variables (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# ==============================================================================

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── PostgreSQL Database (Supabase) ────────────────────────────────────────────
# Connection pooling URL (port 6543, pgbouncer=true) for serverless prisma client
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection URL (port 5432) for migrations and prisma CLI
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
# Optional — enables AI analysis with automatic fallback to deterministic rules if unset
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
