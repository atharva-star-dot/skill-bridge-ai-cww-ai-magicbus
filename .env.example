# ==============================================================================
# Skill Bridge AI — Environment Variables (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# ==============================================================================

# ── Gemini API (server-side only — never expose to client) ──────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. Default: gemini-2.5-flash (fast, JSON-mode capable).
# Run scripts/probe-gemini.ts to discover which models work with your key.
# Options: gemini-2.5-flash | gemini-3.8-flash | gemini-3.5-flash-lite | gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# ── Database ────────────────────────────────────────────────────────────────
# Local SQLite (default — works out of the box):
DATABASE_URL="file:./dev.db"

# Production PostgreSQL on Supabase (for Vercel deployment):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ── Supabase (optional — only needed for Supabase auth/storage) ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
