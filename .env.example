# Copy to .env.local and replace the placeholders with values from your projects.
# Never commit .env.local or share credentials.

# Supabase Auth (public client configuration)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Supabase Postgres: pooled transaction connection for the app
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Postgres connection for administrative tools
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"

# Server-only Supabase Auth Admin key. Never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optional Gemini integration; unset the key to use deterministic fallbacks.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallback model IDs; only the first distinct backup is used.
GEMINI_FALLBACK_MODELS=

# Cleanup script only deletes profiles ending in this exact email domain.
TEST_EMAIL_DOMAIN=example.test
