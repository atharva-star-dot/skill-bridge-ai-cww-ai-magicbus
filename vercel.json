  "buildCommand": "npx prisma generate && npx prisma db push && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "env": {
    "GEMINI_API_KEY": "@gemini-api-key",
    "DATABASE_URL": "@database-url",
    "GEMINI_MODEL": "gemini-2.0-flash-exp"
  }
}
